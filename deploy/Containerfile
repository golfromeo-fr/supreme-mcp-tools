# M4 node image — ONE launcher process per container (H4, 2026-09-10).
# Build from the repo root (context is the repo, not deploy/):
#   podman build -f deploy/Containerfile -t mcp-node .
# The node reads its config from a MOUNTED .env (see deploy/podman-compose.yml):
#   "same image, one mounted .env" — no unique local state in the image.
# Digest pin = the exact base live-verified 2026-09-14; bump consciously.
#
# Version stamping: pass build args (deploy/publish-image.sh and startcluster
# do this automatically):
#   --build-arg IMAGE_VERSION=<git describe> --build-arg GIT_SHA=<sha>
FROM docker.io/library/python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285

ARG IMAGE_VERSION=dev
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="supreme-mcp-tools node" \
      org.opencontainers.image.description="One-process MCP launcher node (all tools, CPU torch, multi-user)" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.source="https://github.com/golfromeo-fr/supreme-mcp-tools"

WORKDIR /app

# Dependencies first — cached unless requirements change.
# python-docx is a DEFAULT-tool dependency since convertermcp joined the set.
# torch is forced to the CPU wheel BEFORE sentence-transformers so the CUDA
# variants (multi-GB nvidia/cudnn libs) never enter the image — the host and
# both pod environments run embeddings on CPU.
COPY requirements.txt ./
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements.txt

# Code + runtime config (ports.json, launcher_config.json live in config/)
COPY launcher/ ./launcher/
COPY monitoring/ ./monitoring/
COPY tools/ ./tools/
COPY mcp_ui/ ./mcp_ui/
COPY config/ ./config/
COPY launchmcp.py .
COPY deploy/healthcheck.py ./healthcheck.py

# The shared-state backends (users + state docs) must be reachable; the
# tools' data planes are whatever the mounted .env points at.
# Runtime state: keep logs inside the container unless a volume is declared.
RUN mkdir -p /app/logs

# Default tool set — override with TOOLS_LIST in compose/K8s
# (space-separated; empty entries are ignored by the shell expansion).
ENV MCP_AUTH_MODE=multi \
    MCP_USERS_BACKEND=db \
    MCP_STATE_BACKEND=db \
    TOOLS_LIST="simplemcp convertermcp webmcp"
# NOTE: POSTGRES_HOST/USER/PASSWORD/DB and the identity/management secrets
# come from the mounted .env — NOT baked into the image.

# launchmcp.py loads the root .env BEFORE any tool import (auth-order fix,
# 2026-09-09): the mounted /app/.env is what makes this node multi-user.
# ${TOOLS_LIST:-...} guard: an empty/override TOOLS_LIST must not fall back
# to the launcher's full discovered set — keep the light trio instead.
CMD ["sh", "-c", "exec python3 ./launchmcp.py --health-check-logs disable ${TOOLS_LIST:-simplemcp convertermcp webmcp}"]
