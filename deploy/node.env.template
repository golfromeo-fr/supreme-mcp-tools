# M4 node environment — COPY to deploy/node.env and fill in.
# Every node mounts THE SAME FILE (identity/config plane = shared).
# Never commit the filled-in copy.

# ── identity / auth plane ──────────────────────────────────────────
MCP_AUTH_MODE=multi
MCP_UI_USERNAME=admin
MCP_UI_PASSWORD=change-me-admin-password
# persistent UI sessions (generate once, share across nodes)
MCP_UI_SECRET=change-me-long-random-string
# break-glass central API key (admins' user keys also work — multi-admin)
MCP_MANAGEMENT_API_KEY=change-me-central-key

# ── shared state plane (M4) ────────────────────────────────────────
# Pick ONE block to match the topology you pass startlauncher-podman:
#   pg    -> keep the POSTGRES_* block (host must be `db`)
#   turso -> keep the TURSO_DATABASE_URL=http://db:8080 line
#   external-pg / external-turso -> your own DSNs (host must NOT be `db`)
# NOTE: with both set, POSTGRES wins (resolve_sql_backend prefers PG).
MCP_USERS_BACKEND=db
MCP_STATE_BACKEND=db

# -- embedded/external Postgres (topology: pg / external-pg) --------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=mcp
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=mcp

# -- embedded/external Turso (topology: turso / external-turso) -----
# embedded (compose): http://db:8080 | external: libsql://... (Turso cloud)
# TURSO_DATABASE_URL=http://db:8080
# TURSO_AUTH_TOKEN=

# ── data planes (point at the SHARED instances, not localhost) ────
# memorymcp / ragmcp: a real network Turso or the compose qdrant profile.
# A local file: Turso URL is NOT shareable across containers.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333

# ── node tool set ─────────────────────────────────────────────────
# Set per node in compose-common.yml `environment:` (the shell expands it
# before the mounted .env is read). Light default; the heavy tools need
# their data planes (see deploy/README.md 'full' topology).
