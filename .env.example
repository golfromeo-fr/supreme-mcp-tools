# supreme-mcp-tools — .env template
#
# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored (never commit it); this template carries placeholders only.
# Backend priority chain: config.json storage block > env vars > default.

# ── Management UI (mcp_ui, port 8400) ────────────────────────────────────────
MCP_UI_HOST=127.0.0.1
MCP_UI_THEME=dark
MCP_UI_REFRESH_INTERVAL=5
MCP_UI_USERNAME=CHANGE-ME-ui-username
MCP_UI_PASSWORD=CHANGE-ME-ui-password
MCP_UI_SECRET=CHANGE-ME-ui-session-secret

# ── Pod UI (pod_ui, port 8401; optional) ─────────────────────────────────────
# MCP_PODUI_PORT=8401
# MCP_PODUI_HOST=127.0.0.1

# ── Central management API (8200) ─────────────────────────────────────────────
MCP_MANAGEMENT_API_KEY=CHANGE-ME-management-api-key
# MCP_AUTH_MODE=mono            # mono (default) | multi — pod images bake multi
# MCP_API_URL=                  # UI → API base URL override (default: ports.json 8200)
# MCP_API_KEY=                  # UI → API bearer fallback (MCP_MANAGEMENT_API_KEY wins)

# ── Storage: SQL + vector backends ────────────────────────────────────────────
# Exactly one SQL/vector combo; see tools/memorymcp/BACKENDS.md for all seven.
TURSO_DATABASE_URL=file:/CHANGE/ME/memorymcp.db
# QDRANT_HOST=                  # alternative backend (default combo)
# QDRANT_PORT=6333
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_USER=
# POSTGRES_PASSWORD=CHANGE-ME
# POSTGRES_DB=
# POSTGRES_TEST_DSN=postgresql://user:CHANGE-ME@127.0.0.1:5433/testdb

# ── databasemcp connection presets (DB_PRESET_<NN>) ───────────────────────────
DB_PRESET_02=CHANGE-ME-postgresql-dsn
DB_PRESET_02_DESC=test PG
DB_PRESET_02_NAME=pgtest                 # optional nickname (case-insensitive)
DB_PRESET_03=file:/CHANGE/ME/some.db
DB_PRESET_03_DESC=local libsql
DB_PRESET_03_NAME=memdb                  # optional nickname (case-insensitive)
# DB_PRESET_AUTOCONNECT=01,02

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
HF_HUB_DISABLE_SYMLINKS=1
# AZURE_EMBEDDING_API_URL=
# AZURE_EMBEDDING_MODEL=
# OPENROUTER_KEY=CHANGE-ME

# ── Search / AI APIs ──────────────────────────────────────────────────────────
AI_API_KEY=CHANGE-ME
BRAVE_SEARCH_API_KEY=CHANGE-ME
SERPAPI_API_KEY=CHANGE-ME
SMARTGRAPH_API_KEY=CHANGE-ME
SMARTGRAPH_BASE_URL=CHANGE-ME-base-url
SMARTGRAPH_MODEL=CHANGE-ME-model

# ── Cache / timeouts ──────────────────────────────────────────────────────────
MCP_API_TIMEOUT=30
SIMPLEMCP_SECRET=CHANGE-ME
SIMPLEMCP_DEFAULT_TIMEOUT_MS=10000
SIMPLEMCP_MAX_TIMEOUT_MS=60000
MCP_CACHE_TTL=300
MCP_CACHE_MAX_SIZE=1000
MCP_CACHE_ENABLED=true

# ── Multi-user test account (E3) ──────────────────────────────────────────────
MCP_USER_TESTER_PASSWORD=CHANGE-ME
MCP_USER_TESTER_ROLE=user
MCP_USER_TESTER_SERVERS=webmcp,simplemcp
MCP_USER_TESTER_KEY=CHANGE-ME-tester-mcp-key

# ── Logging knobs ─────────────────────────────────────────────────────────────
# Per-request access lines (mcp.access logger: every client connect, tool call,
# auth rejection). Defaults give the full trail minus /health-404 probe noise.
# MCP_DISABLE_REQUEST_LOGS=1            # uncomment for full silence (or ./startlauncher --quiet)
# MCP_ACCESS_LOG_SKIP_404_PATHS=/health # 404s on these paths are not logged; empty = log all
# MCP_HEALTH_CHECK_LOGS=disable         # launcher health-check lines (startlauncher default: disable)

# ── Launcher / client bootstrap knobs (scripts/*.sh) ──────────────────────────
# STARTLAUNCHER_TOOLS=simplemcp ragmcp webmcp memorymcp databasemcp convertermcp
# STARTLAUNCHER_ENGINE=legacy            # legacy (launchmcp.py) | modern (python -m launcher)
# STARTLAUNCHER_HEALTH_CHECK_LOGS=disable
# STARTLAUNCHER_VERBOSE=1
# OPENCODE_MCP_TOOLS=webmcp simplemcp ragmcp memorymcp
