{
  "toolDirectories": [
    "tools/webmcp",
    "tools/oraclemcp",
    "tools/convertermcp",
    "tools/ragmcp",
    "tools/simplemcp"
  ],
  "portAllocation": {
    "mode": "manual",
    "basePort": 8000,
    "portRange": [8000, 9000],
    "ports": {
      "oraclemcp": 8000,
      "webmcp": 8001,
      "simplemcp": 8002,
      "convertermcp": 8003,
      "ragmcp": 8004
    },
    "managementPorts": {
      "oraclemcp": 9000,
      "webmcp": 9001,
      "simplemcp": 9002,
      "convertermcp": 9003,
      "ragmcp": 9004
    }
  },
  "fefV3": {
    "enabled": true,
    "managementServer": {
      "host": "0.0.0.0",
      "cors": {
        "enabled": true,
        "allowOrigins": ["*"],
        "allowMethods": ["GET", "POST", "PUT", "DELETE"],
        "allowHeaders": ["*"]
      }
    },
    "security": {
      "apiKeyAuth": false,
      "rateLimiting": {
        "enabled": false,
        "requestsPerMinute": 60
      }
    },
    "monitoring": {
      "enabled": true,
      "metricsEndpoint": "/metrics"
    }
  },
  "server": {
    "host": "0.0.0.0",
    "logLevel": "info"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/launcher.log"
  },
  "errorHandling": {
    "continueOnError": true,
    "failFast": false
  }
}
