{
  "toolDirectories": [
    "tools/webmcp",
    "tools/databasemcp",
    "tools/simplemcp",
    "tools/convertermcp",
    "tools/ragmcp",
    "tools/memorymcp"
  ],
  "server": {
    "host": "0.0.0.0",
    "logLevel": "info"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/launcher.log",
    "rotationWhen": "D",
    "rotationInterval": 30,
    "rotationBackupCount": 6,
    "maxBytes": 10485760
  },
  "errorHandling": {
    "continueOnError": true,
    "failFast": false
  }
}
