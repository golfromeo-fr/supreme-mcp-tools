{
  "toolDirectories": [
    "tools/webmcp",
    "tools/oraclemcp",
    "tools/simplemcp",
    "tools/convertermcp",
    "tools/ragmcp"
  ],
  "fefV3": {
    "enabled": true,
    "managementServer": {
      "host": "0.0.0.0",
      "cors": {
        "enabled": true,
        "allowOrigins": ["*"],
        "allowMethods": ["GET", "POST", "PUT", "DELETE"],
        "allowHeaders": ["*"]
      }
    },
    "security": {
      "apiKeyAuth": false,
      "rateLimiting": {
        "enabled": false,
        "requestsPerMinute": 60
      }
    },
    "monitoring": {
      "enabled": true,
      "metricsEndpoint": "/metrics"
    }
  },
  "server": {
    "host": "0.0.0.0",
    "logLevel": "info"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/launcher.log"
  },
  "errorHandling": {
    "continueOnError": true,
    "failFast": false
  }
}
